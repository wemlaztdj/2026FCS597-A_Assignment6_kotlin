<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/GardenTitle"
            android:text="@string/your_garden" />

        <Button
            android:id="@+id/garden_create_goal_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/create_savings_goal" />

        <TextView
            android:id="@+id/garden_status_text"
            style="@style/GardenBody"
            android:layout_marginTop="16dp"
            android:text="@string/garden_loading"
            android:accessibilityLiveRegion="polite" />

        <LinearLayout
            android:id="@+id/garden_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>

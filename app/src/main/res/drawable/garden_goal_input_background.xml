<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/garden_goal_disabled" />
            <stroke android:width="1dp" android:color="@color/garden_goal_outline" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/garden_goal_surface" />
            <stroke android:width="2dp" android:color="@color/garden_goal_accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/garden_goal_surface" />
            <stroke android:width="1dp" android:color="@color/garden_goal_outline" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
